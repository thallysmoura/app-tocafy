POSTGRES_USER=tocafy
POSTGRES_PASSWORD=tocafy
POSTGRES_DB=tocafy

# Local dev (pnpm start:dev fora do Docker): localhost. Docker-compose: postgres.
DATABASE_URL=postgresql://tocafy:tocafy@localhost:5432/tocafy?schema=public

# Pasta com os MP3s a importar (recursivo)
MUSIC_DIR=C:\Users\thallys.moura\Documents\Músicas

API_PORT=3001
NODE_ENV=development

# CORS: lista separada por vírgula. Em produção: https://tocafy.mouora.com
CORS_ORIGINS=http://localhost:3002

# Auth
JWT_ACCESS_SECRET=troque-este-valor-dev
JWT_REFRESH_SECRET=troque-este-outro-valor-dev
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Seed do usuário demo — a senha NUNCA fica hardcoded; sem essa env o seed falha.
DEMO_USER_EMAIL=thallysmouraof@gmail.com
DEMO_USER_PASSWORD=

# Web Push (gerar com: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:thallysmouraof@gmail.com

NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Login com Google — config pública do app Firebase (não são segredos).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# A credencial do Firebase Admin (backend) NÃO vai aqui — é o arquivo
# apps/api/firebase-service-account.json (baixado no console do Firebase,
# nunca comitado). Opcionalmente aponte outro caminho com:
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
